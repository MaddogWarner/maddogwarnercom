---
import AvatarFrame from './AvatarFrame.astro';
import GlowButton from './GlowButton.astro';
---

<section class="hero">
  <div class="container hero-grid">
    <AvatarFrame />
    <div class="copy">
      <p class="mono terminal prompt">&gt; MadDogWarner<span class="cursor">_</span></p>
      <h1>Hacking. Defending. Building.</h1>
      <p class="subtitle">IT professional. Homelab operator. Security obsessive.</p>
      <div class="actions">
        <GlowButton href="/projects/" variant="filled">View Projects</GlowButton>
        <GlowButton href="/blog/">Read the Blog</GlowButton>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 4.25rem);
    display: grid;
    align-items: center;
    background:
      linear-gradient(rgba(5, 5, 8, 0.72), rgba(5, 5, 8, 0.94)),
      url('/images/hero-bg.png') center / cover;
    padding: 4rem 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .copy {
    max-width: 42rem;
  }

  .prompt {
    margin: 0 0 0.8rem;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .cursor {
    animation: cursor-blink 1s steps(1) infinite;
  }

  h1 {
    margin: 0;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(3rem, 8vw, 6.8rem);
    letter-spacing: 0;
    line-height: 0.95;
  }

  .subtitle {
    margin: 1.1rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .actions {
      justify-content: center;
    }
  }
</style>

