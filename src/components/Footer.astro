---
import { GitBranch, Rss } from '@lucide/astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <p>&copy; {year} MadDogWarner. All rights reserved.</p>
    <p>Built with Astro + Tailwind by MadDogWarner, Claude & Codex</p>
    <div class="social-links">
      <a href="https://github.com/MadDogWarner" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <GitBranch size={20} aria-hidden="true" />
      </a>
      <a href="https://www.facebook.com/profile.php?id=61590544282542" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>
      <a href="https://discord.gg/vU2jbvkp3q" target="_blank" rel="noopener noreferrer" aria-label="Discord">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.004.027.015.053.031.068a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
        </svg>
      </a>
    </div>
  </div>
  <nav class="legal-links" aria-label="Privacy and data collection">
    <a href="/privacy/">Privacy</a>
    <a href="/data-collection/">Data Collection</a>
    <a href="/copyright/">Copyright</a>
    <a href="/rss.xml" aria-label="RSS feed"><Rss size={14} aria-hidden="true" /> RSS</a>
  </nav>
  <p class="tagline mono">Scanning for vulnerabilities... none found.</p>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(0, 180, 255, 0.28);
    background: rgba(5, 5, 8, 0.94);
    padding: 2rem 0;
    color: var(--color-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }

  p {
    margin: 0;
    font-size: 0.88rem;
  }

  .footer-grid p:nth-child(2) {
    text-align: center;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-self: end;
  }

  .social-links a {
    color: var(--color-accent);
    transition: opacity 150ms ease;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    opacity: 0.7;
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 1rem;
    font-size: 0.82rem;
  }

  .legal-links a {
    color: var(--color-muted);
  }

  .legal-links a:hover,
  .legal-links a:focus-visible {
    color: var(--color-accent);
  }

  .tagline {
    margin-top: 1rem;
    text-align: center;
    color: var(--color-terminal);
    font-size: 0.8rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .social-links {
      justify-self: center;
    }
  }
</style>
