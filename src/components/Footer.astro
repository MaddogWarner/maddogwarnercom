---
import { GitBranch } from '@lucide/astro';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <p>&copy; {year} MadDogWarner</p>
    <p>Built with Astro + Tailwind by MadDogWarner, Claude & Codex</p>
    <a href="https://github.com/MadDogWarner" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <GitBranch size={20} aria-hidden="true" />
    </a>
  </div>
  <nav class="legal-links" aria-label="Privacy and data collection">
    <a href="/privacy/">Privacy</a>
    <a href="/data-collection/">Data Collection</a>
  </nav>
  <p class="tagline mono">Scanning for vulnerabilities... none found.</p>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(0, 180, 255, 0.28);
    background: rgba(5, 5, 8, 0.94);
    padding: 2rem 0;
    color: var(--color-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }

  p {
    margin: 0;
    font-size: 0.88rem;
  }

  .footer-grid p:nth-child(2) {
    text-align: center;
  }

  a {
    justify-self: end;
    color: var(--color-accent);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 1rem;
    font-size: 0.82rem;
  }

  .legal-links a {
    color: var(--color-muted);
  }

  .legal-links a:hover,
  .legal-links a:focus-visible {
    color: var(--color-accent);
  }

  .tagline {
    margin-top: 1rem;
    text-align: center;
    color: var(--color-terminal);
    font-size: 0.8rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    a {
      justify-self: center;
    }
  }
</style>
