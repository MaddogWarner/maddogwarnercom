---
import { GitBranch, Lock, Menu, X } from '@lucide/astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? current === '/' : current.startsWith(href);
---

<header class="site-header">
  <nav class="nav container" aria-label="Primary navigation">
    <a class="brand" href="/">
      <Lock size={18} aria-hidden="true" />
      <span>MadDogWarner</span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
      <Menu class="open-icon" size={24} aria-hidden="true" />
      <X class="close-icon" size={24} aria-hidden="true" />
      <span class="sr-only">Toggle menu</span>
    </button>
    <div class="links" data-menu id="mobile-menu">
      {links.map((link) => (
        <a class:list={[isActive(link.href) && 'active']} href={link.href}>{link.label}</a>
      ))}
      <div class="social-icons">
        <a class="github-link" href="https://github.com/MadDogWarner" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <GitBranch size={19} aria-hidden="true" />
        </a>
        <a class="github-link" href="https://www.facebook.com/profile.php?id=61590544282542" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a class="github-link" href="https://discord.com/channels/1507722104936726538/1507722109546270835" target="_blank" rel="noopener noreferrer" aria-label="Discord">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.004.027.015.053.031.068a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-menu]');

  button?.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('open', !expanded);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(26, 26, 62, 0.75);
    background: rgba(5, 5, 8, 0.78);
    backdrop-filter: blur(12px);
  }

  .nav {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand,
  .links,
  .links a {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.55rem;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .brand svg {
    color: var(--color-accent);
  }

  .links {
    gap: 1.25rem;
  }

  .links a {
    position: relative;
    min-height: 2.5rem;
    color: var(--color-muted);
    font-size: 0.94rem;
    font-weight: 700;
  }

  .links a:hover,
  .links a.active {
    color: var(--color-accent);
  }

  .links a.active::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.3rem;
    left: 0;
    height: 2px;
    background: var(--color-accent);
  }

  .github-link {
    color: var(--color-accent) !important;
    min-height: auto !important;
    transition: opacity 150ms ease;
  }

  .github-link:hover {
    opacity: 0.7;
  }

  .social-icons {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .menu-button {
    display: none;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: rgba(13, 13, 26, 0.85);
    color: var(--color-accent);
    padding: 0.55rem;
  }

  .close-icon {
    display: none;
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .menu-button {
      display: inline-grid;
      place-items: center;
    }

    .menu-button[aria-expanded="true"] .open-icon {
      display: none;
    }

    .menu-button[aria-expanded="true"] .close-icon {
      display: block;
    }

    .links {
      position: fixed;
      inset: 4.25rem 0 auto;
      display: none;
      min-height: calc(100vh - 4.25rem);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      border-top: 1px solid var(--color-border);
      background: rgba(5, 5, 8, 0.97);
      padding: 1.25rem;
    }

    .links.open {
      display: flex;
    }

    .links a {
      min-height: 3.5rem;
      justify-content: center;
      font-size: 1.08rem;
    }
  }
</style>
