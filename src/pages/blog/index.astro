---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    title: post.data.title,
    date: post.data.date,
    tags: post.data.tags,
    excerpt: post.data.description,
    slug: post.id.replace(/\.mdx?$/, ''),
  }));

const tags = [...new Set(posts.flatMap((post) => post.tags))].sort();
---

<BaseLayout title="Blog" description="MadDogWarner blog posts.">
  <section class="section">
    <div class="container">
      <div class="blog-hero">
        <div class="blog-header">
          <SectionHeader eyebrow="// blog.posts" title="Blog" />
          <a class="rss-link mono" href="/rss.xml" aria-label="Subscribe via RSS">RSS feed</a>
        </div>
        <figure class="hero-art" aria-label="MadDogWarner avatar at a terminal">
          <img
            src="/images/blog-hero.webp"
            alt="MadDogWarner hacker avatar looking back from a terminal workstation"
            loading="eager"
            decoding="async"
          />
          <figcaption
            class="mono terminal-command"
            aria-label="Terminal command: >sudo blogs.sh"
            data-command=">sudo blogs.sh"
          >
            &gt;sudo blogs.sh
          </figcaption>
        </figure>
      </div>
      <details class="filters surface-card">
        <summary class="mono">Filter tags</summary>
        <div class="filter-actions">
          <button type="button" class="active" data-tag-filter="all">all</button>
          {tags.map((tag) => <button type="button" data-tag-filter={tag}>#{tag}</button>)}
        </div>
      </details>
      <div class="grid">
        {posts.map((post) => (
          <div class="post-shell" data-post-tags={post.tags.join(',')}>
            <BlogCard post={post} />
          </div>
        ))}
      </div>
    </div>
  </section>
  <script>
    const filterButtons = document.querySelectorAll('[data-tag-filter]');
    const postShells = document.querySelectorAll('[data-post-tags]');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.getAttribute('data-tag-filter');
        filterButtons.forEach((item) => item.classList.toggle('active', item === button));
        postShells.forEach((post) => {
          const tags = post.getAttribute('data-post-tags')?.split(',') ?? [];
          post.classList.toggle('hidden', selected !== 'all' && !tags.includes(String(selected)));
        });
      });
    });

    const heroImage = document.querySelector<HTMLImageElement>('.hero-art img');
    const terminalCommand = document.querySelector<HTMLElement>('[data-command]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hasTypedCommand = false;

    const typeTerminalCommand = () => {
      if (!terminalCommand || hasTypedCommand) return;

      hasTypedCommand = true;
      const command = terminalCommand.dataset.command ?? '>sudo blogs.sh';

      if (prefersReducedMotion || command.length <= 1) {
        terminalCommand.textContent = command;
        return;
      }

      terminalCommand.textContent = command[0] ?? '';

      [...command.slice(1)].forEach((character, index) => {
        window.setTimeout(() => {
          terminalCommand.textContent += character;
        }, 70 * (index + 1));
      });
    };

    if (terminalCommand && heroImage) {
      terminalCommand.textContent = '';

      if (heroImage.complete && heroImage.naturalWidth > 0) {
        typeTerminalCommand();
      } else {
        heroImage.addEventListener('load', typeTerminalCommand, { once: true });
        heroImage.addEventListener('error', () => {
          terminalCommand.textContent = terminalCommand.dataset.command ?? '>sudo blogs.sh';
        }, { once: true });
      }
    }
  </script>
</BaseLayout>

<style>
  .blog-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(20rem, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    margin-bottom: 2rem;
  }

  .blog-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .blog-hero :global(.section-header) {
    margin-bottom: 0;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .rss-link:hover,
  .rss-link:focus-visible {
    text-decoration: underline;
  }

  .hero-art {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(0, 180, 255, 0.36);
    border-radius: 8px;
    background: rgba(13, 13, 26, 0.88);
    box-shadow: 0 0 32px rgba(0, 180, 255, 0.12);
  }

  .hero-art::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 0, rgba(5, 5, 8, 0.08) 100%),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.025) 0,
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px,
        transparent 5px
      );
    mix-blend-mode: screen;
  }

  .hero-art img {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .terminal-command {
    position: absolute;
    left: 10%;
    top: 40%;
    z-index: 1;
    margin: 0;
    color: var(--color-terminal);
    font-size: clamp(0.82rem, 1.7vw, 1.2rem);
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 0 10px rgba(0, 255, 136, 0.85);
    transform: rotate(-1deg);
    white-space: nowrap;
  }

  .filters {
    margin-bottom: 1.25rem;
    padding: 1rem;
  }

  summary {
    cursor: pointer;
    color: var(--color-accent);
  }

  .filter-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .filter-actions button {
    border: 1px solid rgba(0, 180, 255, 0.34);
    border-radius: 999px;
    background: rgba(0, 180, 255, 0.06);
    color: var(--color-muted);
    cursor: pointer;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.82rem;
    padding: 0.34rem 0.7rem;
  }

  .filter-actions button:hover,
  .filter-actions button:focus-visible,
  .filter-actions button.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 18px var(--color-glow);
  }

  .post-shell {
    display: flex;
  }

  .post-shell.hidden {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    .blog-hero {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .hero-art {
      order: -1;
    }

    .terminal-command {
      left: 8.5%;
      top: 39%;
      font-size: clamp(0.78rem, 4vw, 1rem);
    }

    .grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
  }
</style>
