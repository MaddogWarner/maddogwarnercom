---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => import.meta.env.DEV || !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout title={post.data.title} seoTitle={post.data.seoTitle} description={post.data.description} date={post.data.date} tags={post.data.tags} image={post.data.image} body={post.body}>
  <Content />
</BlogLayout>
