---
import { GitBranch, Mail, ShieldCheck } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with MadDogWarner - IT professional, homelab operator, and security obsessive."
>
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "Contact MadDogWarner",
      "url": "https://maddogwarner.com/contact/"
    }
  </script>

  <section class="section contact">
    <div class="container">
      <SectionHeader eyebrow="// contact.sh" title="Contact" />

      <div class="contact-grid">
        <aside class="contact-info surface-card">
          <Mail size={30} aria-hidden="true" />
          <h3>Have a question, collaboration idea, or want to talk shop?</h3>
          <p>
            Send a message through the form. Do not include credentials, health information, or other
            sensitive data.
          </p>
          <a class="github" href="https://github.com/MadDogWarner" target="_blank" rel="noopener noreferrer">
            <GitBranch size={19} aria-hidden="true" />
            MadDogWarner on GitHub
          </a>
          <a class="github" href="https://www.facebook.com/profile.php?id=61590544282542" target="_blank" rel="noopener noreferrer">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
            MadDogWarner on Facebook
          </a>
          <a class="github" href="https://discord.com/channels/1507722104936726538/1507722109546270835" target="_blank" rel="noopener noreferrer">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.004.027.015.053.031.068a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
            </svg>
            MadDogWarner on Discord
          </a>
          <p class="reply-note mono">Replies are sent by email.</p>
        </aside>

        <div class="form-card surface-card">
          <form id="contact-form" action="https://submit-form.com/VNqUCubq7" method="POST">
            <input type="hidden" name="_email.subject" value="New contact - maddogwarner.com" />
            <input type="hidden" name="_email.from" value="MadDogWarner Contact" />

            <div class="fields">
              <label>
                <span class="mono">Name</span>
                <input name="name" type="text" autocomplete="name" required />
              </label>
              <label>
                <span class="mono">Email</span>
                <input name="email" type="email" autocomplete="email" required />
              </label>
              <label class="field-wide">
                <span class="mono">Subject</span>
                <input name="topic" type="text" required />
              </label>
              <label class="field-wide">
                <span class="mono">Message</span>
                <textarea name="message" rows="5" required></textarea>
              </label>
            </div>

            <div class="captcha">
              <ShieldCheck size={18} aria-hidden="true" />
              <div class="cf-turnstile" data-sitekey="0x4AAAAAADWERx-Xh2VvnZFY" data-theme="dark"></div>
            </div>

            <button type="submit">Send message</button>
          </form>

          <p class="result mono" id="contact-result" role="status" aria-live="polite" hidden></p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const result = document.querySelector<HTMLParagraphElement>('#contact-result');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = submitButton?.textContent ?? 'Send message';

  const showResult = (message: string, state: 'success' | 'error') => {
    if (!result) return;
    result.hidden = false;
    result.textContent = message;
    result.dataset.state = state;
  };

  const setSubmitting = (submitting: boolean) => {
    if (!submitButton) return;
    submitButton.disabled = submitting;
    submitButton.textContent = submitting ? 'Sending...' : submitLabel;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setSubmitting(true);

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify(Object.fromEntries(formData)),
      });
      const data = await response.json();

      if (!response.ok) {
        throw new Error('Contact form submission failed.');
      }

      showResult('Message sent. MadDogWarner will reply when available.', 'success');
      form.reset();
      (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
    } catch (error) {
      showResult('Message could not be sent. Please try again later.', 'error');
    } finally {
      setSubmitting(false);
    }
  });
</script>

<style>
  .contact {
    padding-top: 5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.35fr);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .contact-info,
  .form-card {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .contact-info {
    display: grid;
    gap: 1rem;
  }

  .contact-info > svg {
    color: var(--color-accent);
  }

  h3 {
    margin: 0;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.45rem, 2.5vw, 2.1rem);
    letter-spacing: 0;
    line-height: 1.15;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .github {
    display: inline-flex;
    width: 100%;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    color: var(--color-accent);
    font-weight: 700;
    transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .github:hover,
  .github:focus-visible {
    background: rgba(0, 180, 255, 0.08);
    box-shadow: 0 0 24px var(--color-glow);
    transform: translateY(-1px);
  }

  .reply-note {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    color: var(--color-text);
    font-size: 0.84rem;
    overflow-wrap: anywhere;
  }

  form {
    display: grid;
    gap: 1.25rem;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  label,
  label span {
    display: grid;
    gap: 0.45rem;
  }

  label span {
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .field-wide {
    grid-column: 1 / -1;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid rgba(0, 180, 255, 0.34);
    border-radius: 8px;
    background: rgba(13, 13, 26, 0.88);
    color: var(--color-text);
    padding: 0.78rem 0.9rem;
  }

  textarea {
    min-height: 9rem;
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(0, 180, 255, 0.16);
    outline: none;
  }

  .captcha {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 0.65rem;
    overflow-x: auto;
  }

  .captcha > svg {
    flex: 0 0 auto;
    margin-top: 0.8rem;
    color: var(--color-terminal);
  }

  button {
    width: fit-content;
    min-height: 2.75rem;
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    background: var(--color-accent);
    color: var(--color-bg);
    cursor: pointer;
    padding: 0.72rem 1rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.88rem;
    font-weight: 700;
    transition: background 180ms ease, box-shadow 180ms ease, opacity 180ms ease, transform 180ms ease;
  }

  button:hover,
  button:focus-visible {
    background: #38c6ff;
    box-shadow: 0 0 24px var(--color-glow);
    transform: translateY(-1px);
  }

  button:disabled {
    cursor: wait;
    opacity: 0.68;
    transform: none;
  }

  .result {
    margin-top: 1rem;
    font-size: 0.88rem;
  }

  .result[data-state="success"] {
    color: var(--color-terminal);
  }

  .result[data-state="error"] {
    color: #ff4d4d;
  }

  @media (max-width: 760px) {
    .contact-grid,
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
