---
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';

const { title, seoTitle, description, date, tags, image, body = '' } = Astro.props;
const readingTime = Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 220));
const imageUrl = image ? new URL(image, Astro.site).toString() : undefined;
const canonicalUrl = Astro.url.href;
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: seoTitle ?? title,
  name: title,
  description,
  image: imageUrl,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: {
    '@type': 'Person',
    name: 'MadDogWarner',
    url: new URL('/about/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Person',
    name: 'MadDogWarner',
    url: new URL('/', Astro.site).toString(),
  },
  keywords: tags.join(', '),
  url: canonicalUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};
---

<BaseLayout title={title} seoTitle={seoTitle} description={description} image={image} structuredData={blogPostingSchema}>
  <div class="progress" data-progress></div>
  <article class="container post">
    <p class="breadcrumb mono"><a href="/">Home</a> &gt; <a href="/blog/">Blog</a> &gt; {title}</p>
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={date.toISOString()}>{date.toLocaleDateString('en-AU', { day: '2-digit', month: 'long', year: 'numeric' })}</time>
      <span>{readingTime} min read</span>
    </div>
    <div class="tags">{tags.map((tag: string) => <TagBadge tag={tag} />)}</div>
    {image && <img class="post-image" src={image} alt="" loading="eager" decoding="async" />}
    <div class="prose content">
      <slot />
    </div>
    <footer class="author">Written by MadDogWarner | Assisted by Claude & Codex</footer>
  </article>
  <script>
    const progress = document.querySelector('[data-progress]');
    window.addEventListener('scroll', () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
      progress?.setAttribute('style', `width: ${pct}%`);
    }, { passive: true });
  </script>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    height: 3px;
    background: var(--color-accent);
  }

  .post {
    padding: 4rem 0 6rem;
  }

  .breadcrumb {
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .breadcrumb a {
    color: var(--color-accent);
  }

  h1 {
    margin: 0.7rem 0;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    line-height: 1;
  }

  .meta,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .meta {
    color: var(--color-muted);
  }

  .content {
    margin-top: 2rem;
  }

  .post-image {
    display: block;
    width: min(100%, 32rem);
    aspect-ratio: 1;
    margin: 2rem 0 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    object-fit: cover;
  }

  .author {
    margin-top: 3rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    color: var(--color-muted);
  }
</style>
